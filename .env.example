# Copy to .env and adjust. A public/non-loopback deployment must explicitly set
# distinct SESSION, ENCRYPTION, and capture-worker secrets. The compatibility
# SECRET_KEY fallback is for loopback-only local development, not production.

# Local compatibility only: signs sessions and encrypts stored secrets when the
# explicit keys below are absent. The placeholder is intentionally insecure.
DRIFTWATCH_SECRET_KEY=change-me-to-a-long-random-string
# Required in every public/non-loopback deployment. They must be strong,
# different from each other and from the worker/billing secrets, and explicitly
# present: production does not fall back to DRIFTWATCH_SECRET_KEY. During a
# rolling rotation add the former key to the matching *_PREVIOUS value, then
# remove it after sessions expire and encrypted values have been read/rewritten.
# DRIFTWATCH_SESSION_SECRET_KEY=set-a-distinct-strong-session-key
# DRIFTWATCH_SESSION_SECRET_KEY_PREVIOUS=former-session-key
# DRIFTWATCH_ENCRYPTION_KEY=set-a-distinct-strong-encryption-key
# DRIFTWATCH_ENCRYPTION_KEY_PREVIOUS=former-encryption-key

# Public URL the app is served from; the deployment-owned source for account,
# notification, checkout/portal links and the CSRF origin check. It cannot be
# overridden from database settings.
# Off a loopback host the app refuses the default secret key, marks the session
# cookie Secure, and sends HSTS — so set this to the real https URL in production.
DRIFTWATCH_BASE_URL=http://localhost:8000

# Expose the interactive API docs (/docs, /redoc, /openapi.json). Off by default.
# DRIFTWATCH_EXPOSE_API_DOCS=false

# Behind a reverse proxy you control, set this to the proxy IP/CIDR (or "*") so
# the real client IP — and the login throttle — work. Leave unset when the app
# terminates connections directly. Never set to "*" while directly exposed.
# DRIFTWATCH_FORWARDED_ALLOW_IPS=10.0.0.0/8
# Extra origins to accept for state-changing requests, comma-separated JSON
# is not needed — set as a JSON list via the env, e.g. ["https://monitor.example.com"]
# DRIFTWATCH_TRUSTED_ORIGINS=["https://monitor.example.com"]

# Server bind address.
DRIFTWATCH_HOST=127.0.0.1
DRIFTWATCH_PORT=8000

# Storage. The data directory holds the bundled SQLite database and the log
# file; migrations run on startup unless disabled.
# DRIFTWATCH_DATA_DIR=./data
# DRIFTWATCH_RUN_MIGRATIONS=true

# Sessions and bootstrap. TTL is in hours (default 336 = 14 days); the org name
# is used for the tenant created around the first account.
# DRIFTWATCH_SESSION_TTL_HOURS=336
# DRIFTWATCH_DEFAULT_ORG_NAME=Default organization
# On a fresh loopback installation, the first signup becomes the administrator
# and permanently closes the one-time claim. Later signups are closed by default;
# the administrator can invite users. Existing workspaces are never bootstrapped.
# Non-loopback deployments require this explicit opt-in, or an optional preseed.
# Complete ownership setup before exposing an unclaimed instance to other people.
# DRIFTWATCH_INITIAL_ADMIN_SIGNUP_ENABLED=true
# Optional alternative: seed once on an empty installation (never publish these).
# DRIFTWATCH_INITIAL_ADMIN_EMAIL=owner@example.com
# DRIFTWATCH_INITIAL_ADMIN_PASSWORD=use-a-unique-private-password
# Additional public account creation requires an explicit opt-in. Do not combine
# it with self-serve billing until email ownership verification is implemented.
# DRIFTWATCH_PUBLIC_REGISTRATION_ENABLED=false

# Stripe billing remains disabled until all provider, legal, and self-serve
# gates are deliberately enabled. Self-serve checkout is for manually created
# tenants and requires public registration to remain closed.
# DRIFTWATCH_BILLING_PROVIDER=disabled
# DRIFTWATCH_BILLING_SELF_SERVE_ENABLED=false
# DRIFTWATCH_BILLING_LEGAL_GATE_ENABLED=false
# DRIFTWATCH_BILLING_TERMS_VERSION=
# DRIFTWATCH_BILLING_PRIVACY_VERSION=
# Public HTTPS links to the exact approved document artifacts shown at checkout.
# DRIFTWATCH_BILLING_TERMS_URL=https://legal.example.com/terms/2026-07
# DRIFTWATCH_BILLING_PRIVACY_URL=https://legal.example.com/privacy/2026-07
# Lowercase SHA-256 of the exact published files. Changing document content
# requires a new version and digest; stale checkout consent is rejected.
# DRIFTWATCH_BILLING_TERMS_SHA256=
# DRIFTWATCH_BILLING_PRIVACY_SHA256=
# DRIFTWATCH_BILLING_PAST_DUE_GRACE_DAYS=7
# DRIFTWATCH_BILLING_WEBHOOK_TOLERANCE_SECONDS=300
# DRIFTWATCH_BILLING_WEBHOOK_MAX_BODY_BYTES=524288
# Test mode requires sk_test_; live mode requires sk_live_. Restricted or
# unknown key types fail configuration validation. Webhook secrets use whsec_.
# DRIFTWATCH_STRIPE_SECRET_KEY=
# DRIFTWATCH_STRIPE_WEBHOOK_SECRET=
# DRIFTWATCH_STRIPE_API_VERSION=2025-06-30.basil
# DRIFTWATCH_STRIPE_LIVEMODE=false
# Live mode pins this to the official origin; custom HTTPS origins are test-only.
# DRIFTWATCH_STRIPE_API_BASE_URL=https://api.stripe.com
# DRIFTWATCH_STRIPE_TIMEOUT_SECONDS=15
# Enabling the legal gate is an operator attestation, not legal approval. Keep
# self-serve and live mode off until the deployment checks in docs/DEPLOY.md pass.

# Seed an administrator on first start (recommended for non-local deployment).
# Public registration stays closed unless explicitly enabled. Keep the seed
# password in a secret manager and remove it from runtime after successful seed.
# DRIFTWATCH_INITIAL_ADMIN_EMAIL=admin@example.com
# DRIFTWATCH_INITIAL_ADMIN_PASSWORD=change-me

# Background scheduler.
DRIFTWATCH_SCHEDULER_ENABLED=true
# IANA zone used for substitution (holiday-cover) date boundaries, e.g. America/New_York
DRIFTWATCH_SCHEDULER_TIMEZONE=UTC
DRIFTWATCH_SCHEDULER_TICK_SECONDS=30
DRIFTWATCH_MAX_CHECKS_PER_TICK=50
DRIFTWATCH_SNAPSHOT_RETENTION=50
# Durable check queue bounds and retry lease. Defaults are suitable for a small
# single-replica install; tune only from observed queue depth and job duration.
# DRIFTWATCH_CHECK_QUEUE_CAPACITY=1000
# DRIFTWATCH_CHECK_QUEUE_PER_ORG_CAPACITY=100
# DRIFTWATCH_CHECK_JOB_LEASE_SECONDS=180
# DRIFTWATCH_CHECK_JOB_MAX_ATTEMPTS=5
# DRIFTWATCH_CHECK_JOB_RETENTION_DAYS=30
# DRIFTWATCH_ACCOUNT_EMAIL_JOB_RETENTION_DAYS=30
# Hard time ceiling per site so one slow page cannot stall a scheduler tick.
# DRIFTWATCH_PER_SITE_BUDGET_SECONDS=120
# Prune AI usage rows older than this many days.
# DRIFTWATCH_AI_USAGE_RETENTION_DAYS=180

# Page capture. The User-Agent identifies the capture browser to the sites you
# watch — append a contact URL (e.g. "+https://monitor.example.com") if you want
# site owners to be able to reach you about the traffic.
# DRIFTWATCH_CAPTURE_USER_AGENT="Mozilla/5.0 (compatible; DriftwatchBot/1.0)"
# Per-capture page-load timeout and post-load settle delay.
# DRIFTWATCH_CAPTURE_TIMEOUT_SECONDS=30
# DRIFTWATCH_CAPTURE_SETTLE_MS=750
# Browser to capture with: auto | msedge | chrome | chromium.
# DRIFTWATCH_CAPTURE_BROWSER_CHANNEL=auto
# Pin the browser to the vetted IP (anti DNS-rebind). Leave on.
# DRIFTWATCH_CAPTURE_PIN_DNS=true
# Bound on browser launch/detection time.
# DRIFTWATCH_CAPTURE_LAUNCH_TIMEOUT_SECONDS=30
# Ceiling on browsers alive at once (scheduler + manual checks); raise on a
# larger box — each capture holds a Chromium.
# DRIFTWATCH_MAX_CONCURRENT_CAPTURES=4
# Public deployments must use the browser-only worker. Generate a separate
# random token (at least 32 characters); never reuse a session/encryption key.
# Docker Compose fixes the internal URL itself but still requires the token.
# DRIFTWATCH_CAPTURE_WORKER_URL=https://capture-worker.internal
# DRIFTWATCH_CAPTURE_WORKER_TOKEN=set-a-distinct-long-random-token
# Client-side deadline and request/response byte ceilings.
# DRIFTWATCH_CAPTURE_WORKER_CLIENT_TIMEOUT_SECONDS=100
# DRIFTWATCH_CAPTURE_WORKER_MAX_REQUEST_BYTES=65536
# DRIFTWATCH_CAPTURE_WORKER_MAX_RESPONSE_BYTES=8388608
# Permit plain HTTP only on a verified single-host private network. Keep false
# across hosts and use TLS/mTLS instead.
# DRIFTWATCH_CAPTURE_WORKER_ALLOW_INSECURE_HTTP=false
# Emergency compatibility switch for public deployments. This removes the
# process-level browser secrets boundary and should remain false.
# DRIFTWATCH_CAPTURE_ALLOW_IN_PROCESS=false
# Worker-process capacity (set only on the worker service).
# DRIFTWATCH_CAPTURE_WORKER_MAX_CONCURRENT=2
# DRIFTWATCH_CAPTURE_WORKER_MAX_QUEUED=4
# DRIFTWATCH_CAPTURE_WORKER_TIMEOUT_SECONDS=90

# Visual selector picker. Opens a real browser on the host, so it needs a
# display; disable in server containers (the UI then offers the manual selector).
# DRIFTWATCH_PICKER_ENABLED=true
# DRIFTWATCH_PICKER_BROWSER_CHANNEL=auto
# DRIFTWATCH_PICKER_SESSION_TIMEOUT_SECONDS=300
# DRIFTWATCH_PICKER_IDLE_TIMEOUT_SECONDS=120

# OpenAI is optional; without it changes are stored but not classified. The key
# can also be set at runtime in Settings (stored encrypted).
# DRIFTWATCH_OPENAI_API_KEY=sk-...
DRIFTWATCH_OPENAI_MODEL=gpt-4o-mini
# Truncate diffs sent to the model beyond this many characters (cost guard).
# DRIFTWATCH_MAX_DIFF_CHARS_FOR_AI=16000

# Logging.
# DRIFTWATCH_LOG_LEVEL=INFO

# Use Postgres instead of the default bundled SQLite. The app uses the async
# asyncpg driver; Alembic migrations use psycopg under the hood automatically.
# DRIFTWATCH_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/driftwatch
#
# --- Container / reverse proxy -----------------------------------------
# In a container, bind all interfaces and let the platform pick the port:
# DRIFTWATCH_HOST=0.0.0.0
# A platform-provided $PORT is honoured automatically over DRIFTWATCH_PORT.
# Set the public URL so links, the Secure cookie, HSTS, and the CSRF origin
# check are correct:
# DRIFTWATCH_BASE_URL=https://monitor.example.com
# Set the exact trusted proxy addresses for your deployment so forwarded client
# IPs can drive the login throttle. See docs/DEPLOY.md; do not trust arbitrary peers.
# DRIFTWATCH_FORWARDED_ALLOW_IPS=127.0.0.1
# The visual picker needs a real display, which a server container has not —
# turn it off so the UI cleanly offers the manual selector instead:
# DRIFTWATCH_PICKER_ENABLED=false
#
# Note for docker-compose users: compose reads this file only for the ${...}
# substitutions listed in docker-compose.yml — a variable not forwarded there
# never reaches the container. Add extra settings to the compose environment
# block (or run the image with --env-file).
